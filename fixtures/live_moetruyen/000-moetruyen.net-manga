</style>
<script nonce="qgZPnU1OmCLfhy4H4TYzBK8W">
  (() => {
    const initialKind = "";
    const id = "bfang-boot-skeleton";
    const block = '<span class="bfang-boot-skeleton__block"></span>';
    const sectionHeading = `<div class="bfang-boot-skeleton__section-heading">${block}${block}</div>`;
    const card = `<div class="bfang-boot-skeleton__card"><div class="bfang-boot-skeleton__card-cover"></div><div class="bfang-boot-skeleton__card-body">${block}${block}${block}</div></div>`;
    const escapeAttribute = (value) => (value || "").toString().replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    })[character]);
    const renderBreadcrumb = (pathname, title) => {
      const safeTitle = (title || "").toString().trim();
      if (!safeTitle) return `<div class="bfang-boot-skeleton__breadcrumb manga-detail-breadcrumb">${block}${block}</div>`;
      const isNovel = /^\/novel\//i.test(pathname);
      return `<div class="bfang-boot-skeleton__breadcrumb manga-detail-breadcrumb"><span>${isNovel ? "Truyện chữ" : "Truyện tranh"}</span><span>/</span><span class="bfang-boot-skeleton__breadcrumb-current">${escapeAttribute(safeTitle)}</span></div>`;
    };
    const renderDetailCover = (cover) => {
      const src = cover && typeof cover.src === "string" ? cover.src.trim() : "";
      if (!src) return '<div class="bfang-boot-skeleton__detail-cover cover cover--detail"></div>';
      const adultClass = cover.isAdult ? " cover--adult" : "";
      const revealedClass = cover.isAdultRevealed ? " is-adult-revealed" : "";
      return `<div class="bfang-boot-skeleton__detail-cover bfang-boot-skeleton__detail-cover--reused cover cover--detail${adultClass}${revealedClass}"><img src="${escapeAttribute(src)}" alt="${escapeAttribute(cover.alt)}" decoding="async" /></div>`;
    };
    const renderDetail = (preview) => {
      const data = preview && typeof preview === "object" ? preview : {};
      const title = data.title
        ? `<h1 class="bfang-boot-skeleton__preview-title manga-detail-title">${escapeAttribute(data.title)}</h1>`
        : '<span class="bfang-boot-skeleton__block bfang-boot-skeleton__detail-title"></span>';
      return `<div class="bfang-boot-skeleton__detail detail-grid manga-detail-hero"><div class="bfang-boot-skeleton__detail-cover-wrap detail-cover">${renderDetailCover(data.cover)}</div><div class="bfang-boot-skeleton__detail-info detail-info">${title}<span class="bfang-boot-skeleton__block bfang-boot-skeleton__detail-meta"></span><span class="bfang-boot-skeleton__block bfang-boot-skeleton__detail-meta bfang-boot-skeleton__detail-meta--short"></span><div class="bfang-boot-skeleton__pills">${block}${block}${block}</div><div class="bfang-boot-skeleton__metrics">${block}${block}${block}${block}</div><div class="bfang-boot-skeleton__copy">${block}${block}${block}</div><span class="bfang-boot-skeleton__block bfang-boot-skeleton__button"></span></div></div>`;
    };
    const pagePanels = `<div class="bfang-boot-skeleton__page-grid"><div class="bfang-boot-skeleton__page-panel">${block}${block}${block}${block}</div><div class="bfang-boot-skeleton__page-panel">${block}${block}${block}</div></div>`;
    const singlePanel = `<div class="bfang-boot-skeleton__page-grid bfang-boot-skeleton__page-grid--single"><div class="bfang-boot-skeleton__page-panel">${block}${block}${block}${block}</div></div>`;
    const publishedRow = `<div class="bfang-boot-skeleton__published-row"><div class="bfang-boot-skeleton__published-cover"></div><div class="bfang-boot-skeleton__published-body"><span class="bfang-boot-skeleton__block bfang-boot-skeleton__published-title"></span><div class="bfang-boot-skeleton__published-meta">${block}${block}</div><div class="bfang-boot-skeleton__published-copy">${block}${block}${block}${block}</div><span class="bfang-boot-skeleton__block bfang-boot-skeleton__button"></span></div></div>`;
    const chatThread = `<div class="bfang-boot-skeleton__chat-thread"><span class="bfang-boot-skeleton__chat-avatar"></span><div class="bfang-boot-skeleton__chat-thread-copy">${block}${block}</div></div>`;
    const teamRow = `<div class="bfang-boot-skeleton__team-row"><span class="bfang-boot-skeleton__team-row-cover"></span><div class="bfang-boot-skeleton__team-row-copy">${block}${block}${block}</div></div>`;
    let nextPathname = window.location.pathname;
    let shell = null;
    let shellKind = "";
    let shellClassName = "";
    let host = null;
    let mutationObserver = null;
    let resizeObserver = null;
    let watching = false;
    let revision = 0;
    const documentNavigationId = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
    const nativeMobileNavigation = window.navigator && (
      window.navigator.userAgentData?.mobile === true
      || /Android|iPhone|iPad|iPod|Mobile/i.test((window.navigator.userAgent || "").toString())
    );

    const tagDocumentEntry = () => {
      if (!window.history || typeof window.history.replaceState !== "function") return false;
      const state = window.history.state && typeof window.history.state === "object" ? window.history.state : {};
      window.history.replaceState({ ...state, bfangDocumentNavigationId: documentNavigationId }, "", window.location.href);
      return true;
    };

    if (!nativeMobileNavigation) tagDocumentEntry();

    const toPathname = (value) => {
      try {
        const url = new URL((value || window.location.href).toString(), window.location.href);
        return url.origin === window.location.origin ? url.pathname : window.location.pathname;
      } catch (_error) {
        return window.location.pathname;
      }
    };

    const getKind = (pathname) => {
      if (/^\/admin\/login\/?$/i.test(pathname)) return "admin-login";
      if (/^\/admin(?:\/|$)/i.test(pathname)) return "admin";
      if (/^\/m\/manga\/[^/]+\/chapters\/[^/]+\/?$/i.test(pathname)) return "lite-reader";
      if (/^\/manga\/[^/]+\/chapters\/[^/]+\/?$/i.test(pathname)) return "manga-reader";
      if (/^\/novel\/[^/]+\/chapters\/[^/]+\/?$/i.test(pathname)) return "novel-reader";
      if (/^\/novel\/home\/?$/i.test(pathname)) return "listing";
      if (/^\/novel\/list\/?$/i.test(pathname)) return "catalog";
      if (/^\/m\/(?:manga|novel)\/[^/]+\/?$/i.test(pathname)) return "lite-detail";
      if (/^\/(?:manga|novel)\/[^/]+\/?$/i.test(pathname)) return "detail";
      if (/^\/m\/forum(?:\/|$)/i.test(pathname)) return "lite-forum";
      if (/^\/m\/?$/i.test(pathname)) return "lite-home";
      if (pathname === "/") return "home";
      if (/^\/(?:manga|novel)\/?$/i.test(pathname)) return "catalog";
      if (/^\/xuat-ban\/?$/i.test(pathname)) return "published";
      if (/^\/account\/?$/i.test(pathname)) return "account-form";
      if (/^\/account\/saved\/?$/i.test(pathname)) return "account";
      if (/^\/account\/(?:saved\/share\/[^/]+|history)\/?$/i.test(pathname)) return "collection";
      if (/^\/messages\/?$/i.test(pathname)) return "chat";
      if (/^\/team\/[^/]+(?:\/[^/]+)?\/?$/i.test(pathname)) return "team-profile";
      if (/^\/user\/[^/]+\/?$/i.test(pathname)) return "profile";
      if (/^\/tin-tuc(?:\/|$)/i.test(pathname)) return "news";
      return "page";
    };

    const renderContent = (kind, navigationPreview, pathname) => {
      if (kind === "home") {
        return `<div class="bfang-boot-skeleton__home-head"><span class="bfang-boot-skeleton__block bfang-boot-skeleton__eyebrow"></span><div class="bfang-boot-skeleton__home-title">${block}${block}</div><div class="bfang-boot-skeleton__home-copy">${block}${block}</div></div><div class="bfang-boot-skeleton__home-grid"><div class="bfang-boot-skeleton__home-panel"><span class="bfang-boot-skeleton__block bfang-boot-skeleton__panel-label"></span><div class="bfang-boot-skeleton__stats"><div class="bfang-boot-skeleton__stat">${block}${block}</div><div class="bfang-boot-skeleton__stat">${block}${block}</div></div></div><div class="bfang-boot-skeleton__home-panel"><span class="bfang-boot-skeleton__block bfang-boot-skeleton__panel-label"></span><div class="bfang-boot-skeleton__notice">${block}${block}${block}</div></div></div><div class="bfang-boot-skeleton__continuation">${sectionHeading}<div class="bfang-boot-skeleton__cards">${card.repeat(6)}</div></div>`;
      }
      if (kind === "lite-home") {
        return `<div class="bfang-boot-skeleton__lite-panel"><div class="bfang-boot-skeleton__home-title">${block}${block}</div><div class="bfang-boot-skeleton__home-copy">${block}${block}</div><div class="bfang-boot-skeleton__lite-stats"><div class="bfang-boot-skeleton__lite-stat">${block}${block}</div><div class="bfang-boot-skeleton__lite-stat">${block}${block}</div></div><div class="bfang-boot-skeleton__lite-intro"><div>${block}${block}${block}</div><div>${block}${block}${block}</div></div></div><div class="bfang-boot-skeleton__continuation">${sectionHeading}<div class="bfang-boot-skeleton__cards">${card.repeat(4)}</div></div>`;
      }
      if (kind === "catalog") {
        return `${sectionHeading}<span class="bfang-boot-skeleton__block bfang-boot-skeleton__lede"></span><div class="bfang-boot-skeleton__filter"><div class="bfang-boot-skeleton__filter-head">${block}${block}</div><div class="bfang-boot-skeleton__fields"><div class="bfang-boot-skeleton__field">${block}${block}</div><div class="bfang-boot-skeleton__field">${block}${block}</div></div><div class="bfang-boot-skeleton__advanced"></div></div><div class="bfang-boot-skeleton__cards">${card.repeat(6)}</div>`;
      }
      if (kind === "listing") return `${sectionHeading}<div class="bfang-boot-skeleton__cards">${card.repeat(6)}</div>`;
      if (kind === "detail") {
        return `${renderBreadcrumb(pathname, navigationPreview && navigationPreview.title)}${renderDetail(navigationPreview)}<div class="bfang-boot-skeleton__continuation">${sectionHeading}${pagePanels}</div>`;
      }
      if (kind === "lite-detail") {
        return `<div class="bfang-boot-skeleton__lite-panel bfang-boot-skeleton__lite-detail-panel">${renderDetail(navigationPreview)}</div><div class="bfang-boot-skeleton__lite-panel bfang-boot-skeleton__continuation">${sectionHeading}<div class="bfang-boot-skeleton__copy">${block}${block}${block}${block}</div></div>`;
      }
      if (kind === "manga-reader") {
        return '<div class="bfang-boot-skeleton__reader-image"></div>';
      }
      if (kind === "novel-reader") {
        return `<div class="bfang-boot-skeleton__novel-head"><span class="bfang-boot-skeleton__block bfang-boot-skeleton__novel-series"></span><span class="bfang-boot-skeleton__block bfang-boot-skeleton__novel-title"></span><span class="bfang-boot-skeleton__block bfang-boot-skeleton__novel-meta"></span></div><div class="bfang-boot-skeleton__novel-controls">${block}${block}${block}${block}${block}</div><div class="bfang-boot-skeleton__novel-copy">${block.repeat(14)}</div>`;
      }
      if (kind === "lite-reader") {
        return `<div class="bfang-boot-skeleton__lite-panel"><div class="bfang-boot-skeleton__lite-reader-head">${block}<div class="bfang-boot-skeleton__lite-reader-links">${block}${block}</div></div><div class="bfang-boot-skeleton__lite-reader-controls">${block}${block}${block}</div><div class="bfang-boot-skeleton__lite-reader-page"></div></div>`;
      }
      if (kind === "published") {
        return `${sectionHeading}<span class="bfang-boot-skeleton__block bfang-boot-skeleton__lede"></span><div class="bfang-boot-skeleton__published-list">${publishedRow.repeat(2)}</div>`;
      }
      if (kind === "account" || kind === "collection") {
        return `<div class="bfang-boot-skeleton__account-panel"><div class="bfang-boot-skeleton__account-head"><div class="bfang-boot-skeleton__account-title">${block}${block}</div><span class="bfang-boot-skeleton__block bfang-boot-skeleton__account-action"></span></div><div class="bfang-boot-skeleton__account-layout"><div class="bfang-boot-skeleton__account-side">${block}${block}${block}${block}</div><div class="bfang-boot-skeleton__account-content">${block}${block}${block}${block}</div></div></div>`;
      }
      if (kind === "chat") {
        return `<div class="bfang-boot-skeleton__chat"><aside class="bfang-boot-skeleton__chat-side">${block}<div class="bfang-boot-skeleton__chat-search"></div>${chatThread.repeat(4)}</aside><section class="bfang-boot-skeleton__chat-main"><div class="bfang-boot-skeleton__chat-head"><span class="bfang-boot-skeleton__chat-avatar"></span><div class="bfang-boot-skeleton__chat-peer">${block}${block}</div></div><div class="bfang-boot-skeleton__chat-messages"><span class="bfang-boot-skeleton__chat-bubble"></span><span class="bfang-boot-skeleton__chat-bubble"></span><span class="bfang-boot-skeleton__chat-bubble"></span></div><div class="bfang-boot-skeleton__chat-compose">${block}${block}</div></section></div>`;
      }
      if (kind === "profile") {
        return `<div class="bfang-boot-skeleton__profile-hero"><span class="bfang-boot-skeleton__profile-avatar"></span><div class="bfang-boot-skeleton__account-title">${block}${block}${block}</div></div>${pagePanels}`;
      }
      if (kind === "team-profile") {
        return `<div class="bfang-boot-skeleton__team-page"><div class="bfang-boot-skeleton__team-hero"><div class="bfang-boot-skeleton__team-cover"></div><div class="bfang-boot-skeleton__team-identity"><span class="bfang-boot-skeleton__team-avatar"></span><div class="bfang-boot-skeleton__team-meta"><span class="bfang-boot-skeleton__block bfang-boot-skeleton__team-name"></span><div class="bfang-boot-skeleton__team-chips">${block.repeat(5)}</div></div></div></div><div class="bfang-boot-skeleton__team-tabs">${block.repeat(3)}</div><div class="bfang-boot-skeleton__team-overview"><div class="bfang-boot-skeleton__team-side"><div class="bfang-boot-skeleton__team-card">${block.repeat(5)}</div><div class="bfang-boot-skeleton__team-card">${block.repeat(4)}</div></div><div class="bfang-boot-skeleton__team-series">${block}<div class="bfang-boot-skeleton__team-series-list">${teamRow.repeat(4)}</div></div></div></div>`;
      }
      if (kind === "lite-forum") {
        return `<div class="bfang-boot-skeleton__lite-panel">${sectionHeading}<div class="bfang-boot-skeleton__account-content">${block}${block}${block}${block}${block}</div></div>`;
      }
      if (kind === "admin") return `${sectionHeading}${singlePanel}`;
      if (kind === "news") return `${sectionHeading}${pagePanels}`;
      if (kind === "admin-login" || kind === "account-form") return `${sectionHeading}${singlePanel}`;
      return `${sectionHeading}${singlePanel}`;
    };

    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const findHost = () => shellKind === "manga-reader"
      ? document.querySelector("[data-reader-lazy-pages]")
      : document.querySelector("body main");

    const getChrome = (main) => {
      const siblings = main && main.parentElement ? Array.from(main.parentElement.children || []) : [];
      return {
        header: siblings.find((element) => (element.tagName || "").toLowerCase() === "header") || null,
        footer: siblings.find((element) => (element.tagName || "").toLowerCase() === "footer") || null
      };
    };

    const syncBounds = () => {
      if (!shell || !host || typeof host.getBoundingClientRect !== "function") return;

      const root = document.documentElement;
      const visualViewport = window.visualViewport;
      const rootRect = typeof root.getBoundingClientRect === "function" ? root.getBoundingClientRect() : null;
      const viewportWidth = Number(rootRect && rootRect.width) || Number(root.clientWidth) || Number(visualViewport && visualViewport.width) || Number(window.innerWidth) || 0;
      const viewportHeight = Number(visualViewport && visualViewport.height) || Number(root.clientHeight) || Number(window.innerHeight) || 0;
      if (!viewportWidth || !viewportHeight) return;

      const rect = host.getBoundingClientRect();
      const rawLeft = Number(rect.left) || 0;
      const rawTop = Number(rect.top) || 0;
      const rawRight = Number.isFinite(Number(rect.right))
        ? Number(rect.right)
        : rawLeft + (Number(rect.width) || viewportWidth);
      const rawBottom = Number.isFinite(Number(rect.bottom))
        ? Number(rect.bottom)
        : rawTop + (Number(rect.height) || viewportHeight);
      const left = clamp(rawLeft, 0, viewportWidth);
      const rightEdge = clamp(rawRight, left, viewportWidth);
      let top = clamp(rawTop, 0, viewportHeight);
      let bottom = Number(rect.height) > 0
        ? clamp(viewportHeight - rawBottom, 0, viewportHeight - top)
        : 0;
      const { header, footer } = getChrome(host);

      if (header && typeof header.getBoundingClientRect === "function") {
        const headerRect = header.getBoundingClientRect();
        const overlaps = Number(headerRect.right) > left && Number(headerRect.left) < rightEdge;
        if (overlaps && Number(headerRect.bottom) > 0 && Number(headerRect.top) < viewportHeight) {
          top = Math.max(top, clamp(Number(headerRect.bottom), 0, viewportHeight));
        }
      }

      if (footer && typeof footer.getBoundingClientRect === "function") {
        const footerRect = footer.getBoundingClientRect();
        const overlaps = Number(footerRect.right) > left && Number(footerRect.left) < rightEdge;
        if (overlaps && Number(footerRect.bottom) > 0 && Number(footerRect.top) < viewportHeight) {
          bottom = Math.max(bottom, viewportHeight - clamp(Number(footerRect.top), 0, viewportHeight));
        }
      }

      shell.style.top = `${top}px`;
      shell.style.right = `${viewportWidth - rightEdge}px`;
      shell.style.bottom = `${bottom}px`;
      shell.style.left = `${left}px`;
    };

    const clearHost = () => {
      if (resizeObserver) {
        resizeObserver.disconnect();
        resizeObserver = null;
      }
      if (host) host.removeAttribute("data-bfang-boot-host");
      host = null;
    };

    const observeHost = () => {
      if (!host || typeof window.ResizeObserver !== "function") return;
      resizeObserver = new window.ResizeObserver(syncBounds);
      resizeObserver.observe(host);
      const { header, footer } = getChrome(host);
      if (header) resizeObserver.observe(header);
      if (footer) resizeObserver.observe(footer);
    };

    const bindHost = () => {
      if (!document.documentElement.hasAttribute("data-bfang-boot-loading")) return false;
      const nextHost = findHost();
      if (!nextHost) return false;
      if (nextHost !== host) {
        clearHost();
        host = nextHost;
        host.setAttribute("data-bfang-boot-host", "1");
        observeHost();
      }
      shell.className = `${shellClassName} bfang-boot-skeleton--mounted`;
      syncBounds();
      return true;
    };

    const startWatching = () => {
      if (!mutationObserver && typeof window.MutationObserver === "function") {
        mutationObserver = new window.MutationObserver(bindHost);
        mutationObserver.observe(document.documentElement, { childList: true, subtree: true });
      }
      if (watching) return;
      watching = true;
      window.addEventListener("resize", syncBounds);
      window.addEventListener("scroll", syncBounds, { passive: true });
      if (window.visualViewport) {
        window.visualViewport.addEventListener("resize", syncBounds);
        window.visualViewport.addEventListener("scroll", syncBounds, { passive: true });
      }
    };

    const stopWatching = () => {
      if (mutationObserver) {
        mutationObserver.disconnect();
        mutationObserver = null;
      }
      if (!watching) return;
      watching = false;
      window.removeEventListener("resize", syncBounds);
      window.removeEventListener("scroll", syncBounds);
      if (window.visualViewport) {
        window.visualViewport.removeEventListener("resize", syncBounds);
        window.visualViewport.removeEventListener("scroll", syncBounds);
      }
    };

    const show = (value, kindOverride, navigationPreview) => {
      const pathname = toPathname(value);
      revision += 1;
      const kind = kindOverride || getKind(pathname);
      shellKind = kind;
      nextPathname = pathname;
      shell = document.getElementById(id) || shell || document.createElement("div");
      shell.id = id;
      const routeClass = /^\/admin\/teams\/?$/i.test(pathname) ? " bfang-boot-skeleton--admin-teams" : "";
      shellClassName = `bfang-boot-skeleton bfang-boot-skeleton--${kind}${routeClass}`;
      shell.className = shellClassName;
      shell.setAttribute("aria-busy", "true");
      shell.innerHTML = `<p class="bfang-boot-skeleton__status" role="status" aria-live="polite">Đang tải nội dung…</p><div class="bfang-boot-skeleton__main${kind === "detail" ? " manga-detail-page" : ""}" aria-hidden="true">${renderContent(kind, navigationPreview, pathname)}</div>`;
      if (!document.getElementById(id)) document.documentElement.appendChild(shell);
      document.documentElement.setAttribute("data-bfang-boot-kind", kind);
      document.documentElement.setAttribute("data-bfang-boot-loading", "1");
      startWatching();
      bindHost();
    };

    const hide = () => {
      revision += 1;
      stopWatching();
      clearHost();
      if (shell) shell.remove();
      document.documentElement.removeAttribute("data-bfang-boot-kind");
      document.documentElement.removeAttribute("data-bfang-boot-loading");
    };

    const hideWhenReady = (expectedRevision) => {
      const finish = () => {
        if (revision === expectedRevision) hide();
      };
      if (typeof window.requestAnimationFrame === "function") {
        window.requestAnimationFrame(finish);
      } else {
        window.setTimeout(finish, 0);
      }
    };

    window.BfangBootSkeleton = { show, hide };
    show(window.location.pathname, initialKind);

    const ready = () => {
      bindHost();
      hideWhenReady(revision);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", ready, { once: true });
    } else {
      ready();
    }

    document.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const anchor = event.target && event.target.closest ? event.target.closest("a[href]") : null;
      if (!anchor || anchor.hasAttribute("download") || (anchor.target && anchor.target !== "_self")) return;
      try {
        const url = new URL(anchor.href, window.location.href);
        if (url.origin === window.location.origin) nextPathname = url.pathname;
      } catch (_error) {}
    }, true);

    document.addEventListener("submit", (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || (form.target && form.target !== "_self")) return;
      try {
        const url = new URL(form.action || window.location.href, window.location.href);
        if (url.origin === window.location.origin) nextPathname = url.pathname;
      } catch (_error) {}
    }, true);

    if (window.navigation && typeof window.navigation.addEventListener === "function") {
      window.navigation.addEventListener("navigate", (event) => {
        const destination = event.destination;
        if (!destination || destination.sameDocument || event.hashChange) return;
        try {
          const url = new URL(destination.url, window.location.href);
          if (url.origin !== window.location.origin) return;
          nextPathname = url.pathname;
          show(url.pathname);
          const navigationRevision = revision;
          if (event.signal && typeof event.signal.addEventListener === "function") {
            event.signal.addEventListener("abort", () => {
              if (revision === navigationRevision) hide();
            }, { once: true });
          }
        } catch (_error) {}
      });
    }

    window.addEventListener("beforeunload", () => {
      if (!document.documentElement.hasAttribute("data-bfang-boot-loading")) show(nextPathname);
    });
    window.addEventListener("pagehide", (event) => {
      if (event.persisted) hide();
    });
    window.addEventListener("popstate", (event) => {
      hide();
      const entryId = event && event.state && event.state.bfangDocumentNavigationId;
      if (entryId && entryId !== documentNavigationId) window.location.reload();
    });
    window.addEventListener("pageshow", hide);
  })();
</script>

  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  

  

