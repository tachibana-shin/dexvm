<script nonce="C6hY/lA1J87/CR0G2saqXQx+">
  (() => {
    const restoreBadge = (selector, storageKey) => {
      const badge = document.querySelector(selector);
      if (!badge) return;
      try {
        const count = Math.max(0, Math.floor(Number(sessionStorage.getItem(storageKey)) || 0));
        badge.hidden = count === 0;
        badge.textContent = count > 99 ? "99+" : String(count);
        const messageWidget = badge.closest("[data-message-widget]");
        if (messageWidget) messageWidget.setAttribute("data-has-unread", count > 0 ? "1" : "0");
      } catch (_error) {}
    };

    restoreBadge("[data-notify-badge]", "bfang.header.notifications.default");
    restoreBadge("[data-team-notify-badge]", "bfang.header.notifications.team");
    restoreBadge("[data-message-badge]", "bfang.header.messages");
  })();
</script>

