
<!DOCTYPE html>
<html lang="vi">
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  
<style nonce="C6hY/lA1J87/CR0G2saqXQx+">
  html[data-bfang-boot-loading="1"] {
    overflow: hidden;
  }

  html[data-bfang-boot-loading="1"] [data-bfang-boot-host="1"] {
    visibility: hidden !important;
  }

  html[data-bfang-boot-loading="1"] [data-bfang-boot-host="1"] ~ :not(footer):not(script):not(style),
  html[data-bfang-boot-loading="1"] body > dialog,
  html[data-bfang-boot-loading="1"] body > [role="dialog"],
  html[data-bfang-boot-loading="1"] body > .modal,
  html[data-bfang-boot-loading="1"] body > #toast {
    visibility: hidden !important;
  }

  html[data-bfang-boot-loading="1"]:not([data-bfang-boot-kind="manga-reader"])
    body.reader-page.reader-page--reader-mode .site > .site-header,
  html[data-bfang-boot-loading="1"]:not([data-bfang-boot-kind="manga-reader"])
    body.reader-page.reader-page--reader-mode .site > .site-footer {
    display: block !important;
  }

  #bfang-boot-skeleton {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2147483647;
    overflow: hidden;
    contain: layout paint style;
    background: #0c0c0c;
    font-family: var(--font-body, "Noto Sans JP", "Helvetica Neue", Arial, sans-serif);
  }

  #bfang-boot-skeleton.bfang-boot-skeleton--mounted {
    display: block;
  }

  #bfang-boot-skeleton *,
  #bfang-boot-skeleton *::before,
  #bfang-boot-skeleton *::after {
    box-sizing: border-box;
    animation: none !important;
    transition: none !important;
  }

  .bfang-boot-skeleton__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .bfang-boot-skeleton__block {
    display: block;
    background: #202020;
  }

  .bfang-boot-skeleton__main {
    width: min(1120px, 92vw);
    min-height: 100%;
    margin-inline: auto;
    padding-block: 2.7rem 3rem;
  }

  .bfang-boot-skeleton--detail .bfang-boot-skeleton__main {
    padding-block: 1.8rem 3.2rem;
  }

  .bfang-boot-skeleton__section-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.7rem;
  }

  .bfang-boot-skeleton__section-heading .bfang-boot-skeleton__block:first-child {
    width: min(230px, 58vw);
    height: 30px;
  }

  .bfang-boot-skeleton__section-heading .bfang-boot-skeleton__block:last-child {
    flex: 1;
    height: 1px;
    background: #303030;
  }

  .bfang-boot-skeleton__lede {
    width: min(650px, 84vw);
    height: 14px;
    margin-bottom: 1.4rem;
  }

  .bfang-boot-skeleton__home-head {
    display: grid;
    justify-items: start;
    gap: 0.65rem;
    margin-bottom: 1.6rem;
  }

  .bfang-boot-skeleton__eyebrow {
    width: 96px;
    height: 10px;
  }

  .bfang-boot-skeleton__home-title {
    display: grid;
    gap: 0.45rem;
    width: 100%;
    margin-top: 0.15rem;
  }

  .bfang-boot-skeleton__home-title .bfang-boot-skeleton__block {
    width: min(760px, 76%);
    height: 42px;
  }

  .bfang-boot-skeleton__home-title .bfang-boot-skeleton__block:last-child {
    width: min(510px, 52%);
  }

  .bfang-boot-skeleton__home-copy {
    display: grid;
    gap: 0.45rem;
    width: min(680px, 90%);
    margin-top: 0.2rem;
  }

  .bfang-boot-skeleton__home-copy .bfang-boot-skeleton__block {
    width: 100%;
    height: 14px;
  }

  .bfang-boot-skeleton__home-copy .bfang-boot-skeleton__block:last-child {
    width: 72%;
  }

  .bfang-boot-skeleton__home-grid {
    display: grid;
    gap: 1rem;
  }

  .bfang-boot-skeleton__home-panel,
  .bfang-boot-skeleton__filter,
  .bfang-boot-skeleton__account-panel,
  .bfang-boot-skeleton__page-panel,
  .bfang-boot-skeleton__lite-panel {
    border: 1px solid #292929;
    border-radius: 1rem;
    background: #111111;
  }

  .bfang-boot-skeleton__home-panel {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    min-height: 112px;
    padding: 1.2rem 1.4rem;
  }

  .bfang-boot-skeleton__panel-label {
    width: 94px;
    height: 10px;
  }

  .bfang-boot-skeleton__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
  }

  .bfang-boot-skeleton__stat {
    display: grid;
    gap: 0.4rem;
    width: 72px;
  }

  .bfang-boot-skeleton__stat .bfang-boot-skeleton__block:first-child {
    width: 62px;
    height: 24px;
  }

  .bfang-boot-skeleton__stat .bfang-boot-skeleton__block:last-child {
    width: 48px;
    height: 9px;
  }

  .bfang-boot-skeleton__notice {
    display: grid;
    gap: 0.55rem;
    width: min(650px, 100%);
  }

  .bfang-boot-skeleton__notice .bfang-boot-skeleton__block {
    width: 100%;
    height: 12px;
  }

  .bfang-boot-skeleton__notice .bfang-boot-skeleton__block:first-child {
    width: 38%;
  }

  .bfang-boot-skeleton__notice .bfang-boot-skeleton__block:last-child {
    width: 68%;
  }

  .bfang-boot-skeleton__lite-panel {
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
  }

  .bfang-boot-skeleton__lite-stats,
  .bfang-boot-skeleton__lite-intro {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .bfang-boot-skeleton__lite-stat,
  .bfang-boot-skeleton__lite-intro > div {
    display: grid;
    gap: 0.55rem;
    min-height: 74px;
    padding: 0.75rem;
    border: 1px solid #292929;
    border-radius: 0.75rem;
    background: #171717;
  }

  .bfang-boot-skeleton__lite-stat .bfang-boot-skeleton__block:first-child {
    width: 56px;
    height: 20px;
  }

  .bfang-boot-skeleton__lite-stat .bfang-boot-skeleton__block:last-child,
  .bfang-boot-skeleton__lite-intro .bfang-boot-skeleton__block:first-child {
    width: 88px;
    height: 10px;
  }

  .bfang-boot-skeleton__lite-intro .bfang-boot-skeleton__block:not(:first-child) {
    width: 100%;
    height: 11px;
  }

  .bfang-boot-skeleton__filter {
    display: grid;
    gap: 1.15rem;
    margin-bottom: 1.8rem;
    padding: 1.25rem;
  }

  .bfang-boot-skeleton__filter-head {
    display: grid;
    gap: 0.45rem;
  }

  .bfang-boot-skeleton__filter-head .bfang-boot-skeleton__block:first-child {
    width: 190px;
    height: 13px;
  }

  .bfang-boot-skeleton__filter-head .bfang-boot-skeleton__block:last-child {
    width: min(450px, 88%);
    height: 11px;
  }

  .bfang-boot-skeleton__fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: 1rem;
  }

  .bfang-boot-skeleton__field {
    display: grid;
    gap: 0.45rem;
  }

  .bfang-boot-skeleton__field .bfang-boot-skeleton__block:first-child {
    width: 82px;
    height: 9px;
  }

  .bfang-boot-skeleton__field .bfang-boot-skeleton__block:last-child {
    width: 100%;
    height: 42px;
    border: 1px solid #303030;
    border-radius: 0.7rem;
    background: #181818;
  }

  .bfang-boot-skeleton__advanced {
    width: 100%;
    height: 46px;
    border: 1px solid #292929;
    background: #151515;
  }

  .bfang-boot-skeleton__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.8rem;
  }

  .bfang-boot-skeleton__card {
    overflow: hidden;
    border: 1px solid #292929;
    border-radius: 0.8rem;
    background: #111111;
  }

  .bfang-boot-skeleton__card-cover {
    aspect-ratio: 3 / 4;
    background: #202020;
  }

  .bfang-boot-skeleton__card-body {
    display: grid;
    gap: 0.55rem;
    padding: 0.72rem 0.78rem 0.82rem;
  }

  .bfang-boot-skeleton__card-body .bfang-boot-skeleton__block {
    width: 84%;
    height: 13px;
  }

  .bfang-boot-skeleton__card-body .bfang-boot-skeleton__block:nth-child(2) {
    width: 66%;
    height: 10px;
  }

  .bfang-boot-skeleton__card-body .bfang-boot-skeleton__block:nth-child(3) {
    width: 48%;
    height: 10px;
  }

  .bfang-boot-skeleton__breadcrumb {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    min-height: 1.52rem;
    gap: 0.45rem;
    margin-bottom: 1rem;
    color: #98a2b3;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .bfang-boot-skeleton__breadcrumb-current {
    color: #f4f5f7;
    font-weight: 700;
  }

  .bfang-boot-skeleton__breadcrumb .bfang-boot-skeleton__block {
    width: 80px;
    height: 13px;
  }

  .bfang-boot-skeleton__breadcrumb .bfang-boot-skeleton__block:last-child {
    width: 144px;
  }

  .bfang-boot-skeleton__detail {
    display: grid;
    grid-template-columns: 192px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .bfang-boot-skeleton__detail-cover-wrap {
    display: flex;
    justify-content: flex-start;
  }

  .bfang-boot-skeleton__detail-cover {
    width: 192px;
    aspect-ratio: 2 / 3;
    border-radius: 0.82rem;
    background: #202020;
  }

  .bfang-boot-skeleton__detail-cover--reused {
    overflow: hidden;
  }

  .bfang-boot-skeleton__detail-cover--reused img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bfang-boot-skeleton__detail-info {
    display: grid;
    justify-items: start;
    gap: 0.65rem;
  }

  .bfang-boot-skeleton__preview-title {
    display: block;
    width: 100%;
    margin: 0;
    color: #f2f2f2;
    background: none;
    font-family: var(--font-title, "Noto Sans JP", "Helvetica Neue", Arial, sans-serif);
    font-size: clamp(2rem, 3vw, 2.6rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: 0;
  }

  .bfang-boot-skeleton__detail-title {
    width: min(512px, 76%);
    height: 42px;
  }

  .bfang-boot-skeleton__detail-meta {
    width: min(240px, 72%);
    height: 15px;
  }

  .bfang-boot-skeleton__detail-meta--short {
    width: min(160px, 52%);
  }

  .bfang-boot-skeleton__pills,
  .bfang-boot-skeleton__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.1rem;
  }

  .bfang-boot-skeleton__pills .bfang-boot-skeleton__block {
    width: 74px;
    height: 28px;
    border-radius: 999px;
  }

  .bfang-boot-skeleton__pills .bfang-boot-skeleton__block:nth-child(2) {
    width: 86px;
  }

  .bfang-boot-skeleton__pills .bfang-boot-skeleton__block:nth-child(3) {
    width: 62px;
  }

  .bfang-boot-skeleton__metrics {
    gap: 0.65rem 1rem;
  }

  .bfang-boot-skeleton__metrics .bfang-boot-skeleton__block {
    width: 96px;
    height: 14px;
  }

  .bfang-boot-skeleton__copy {
    display: grid;
    gap: 0.45rem;
    width: min(60ch, 100%);
    margin-top: 0.1rem;
  }

  .bfang-boot-skeleton__copy .bfang-boot-skeleton__block {
    width: 100%;
    height: 15px;
  }

  .bfang-boot-skeleton__copy .bfang-boot-skeleton__block:nth-child(2) {
    width: 90%;
  }

  .bfang-boot-skeleton__copy .bfang-boot-skeleton__block:nth-child(3) {
    width: 62%;
  }

  .bfang-boot-skeleton__button {
    width: 136px;
    height: 39px;
    margin-top: 0.3rem;
    border-radius: 0.7rem;
  }

  .bfang-boot-skeleton--lite-home .bfang-boot-skeleton__main,
  .bfang-boot-skeleton--lite-detail .bfang-boot-skeleton__main,
  .bfang-boot-skeleton--lite-reader .bfang-boot-skeleton__main,
  .bfang-boot-skeleton--lite-forum .bfang-boot-skeleton__main {
    width: 100%;
    padding-block: 0 2rem;
  }

  .bfang-boot-skeleton__lite-detail-panel {
    padding: 0.85rem;
  }

  .bfang-boot-skeleton--lite-detail .bfang-boot-skeleton__detail-cover {
    width: min(280px, 100%);
    aspect-ratio: 3 / 4;
  }

  .bfang-boot-skeleton__lite-reader-head {
    display: grid;
    gap: 0.6rem;
  }

  .bfang-boot-skeleton__lite-reader-head .bfang-boot-skeleton__block:first-child {
    width: min(560px, 86%);
    height: 28px;
  }

  .bfang-boot-skeleton__lite-reader-links,
  .bfang-boot-skeleton__lite-reader-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .bfang-boot-skeleton__lite-reader-links .bfang-boot-skeleton__block {
    width: 112px;
    height: 28px;
    border-radius: 999px;
  }

  .bfang-boot-skeleton__lite-reader-controls .bfang-boot-skeleton__block {
    width: 110px;
    height: 36px;
    border: 1px solid #303030;
    border-radius: 0.6rem;
    background: #181818;
  }

  .bfang-boot-skeleton__lite-reader-page {
    height: min(54vh, 520px);
    margin-top: 0.9rem;
    border: 1px solid #292929;
    background: #171717;
  }

  #bfang-boot-skeleton.bfang-boot-skeleton--manga-reader {
    background: #090909;
  }

  .bfang-boot-skeleton--manga-reader .bfang-boot-skeleton__main {
    width: 100%;
    height: 100%;
    padding: 0;
  }

  .bfang-boot-skeleton__reader-image {
    width: min(820px, 92%);
    height: calc(100vh - 16px);
    margin: 8px auto;
    background: #1b1b1b;
  }

  #bfang-boot-skeleton.bfang-boot-skeleton--novel-reader {
    color-scheme: light;
    background: #f7f3e8;
  }

  .bfang-boot-skeleton--novel-reader .bfang-boot-skeleton__main {
    width: min(56rem, calc(100vw - 2rem));
    padding-top: 1.65rem;
  }

  .bfang-boot-skeleton--novel-reader .bfang-boot-skeleton__block {
    background: #ded6c4;
  }

  html[data-novel-reader-theme="soft"] #bfang-boot-skeleton.bfang-boot-skeleton--novel-reader {
    background: #fafaf7;
  }

  html[data-novel-reader-theme="soft"] .bfang-boot-skeleton--novel-reader .bfang-boot-skeleton__block {
    background: #ddddda;
  }

  html[data-novel-reader-theme="dark"] #bfang-boot-skeleton.bfang-boot-skeleton--novel-reader {
    color-scheme: dark;
    background: #121212;
  }

  html[data-novel-reader-theme="dark"] .bfang-boot-skeleton--novel-reader .bfang-boot-skeleton__block {
    background: #2b2b2b;
  }

  .bfang-boot-skeleton__novel-head {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding-bottom: 1.05rem;
    border-bottom: 1px solid #c9bfaa;
  }

  html[data-novel-reader-theme="dark"] .bfang-boot-skeleton__novel-head {
    border-bottom-color: #393939;
  }

  .bfang-boot-skeleton__novel-series {
    width: min(260px, 68%);
    height: 16px;
  }

  .bfang-boot-skeleton__novel-title {
    width: min(420px, 82%);
    height: 16px;
  }

  .bfang-boot-skeleton__novel-meta {
    width: min(250px, 60%);
    height: 11px;
  }

  .bfang-boot-skeleton__novel-controls {
    display: flex;
    justify-content: center;
    gap: 0.48rem;
    margin: 1rem auto 2.45rem;
  }

  .bfang-boot-skeleton__novel-controls .bfang-boot-skeleton__block {
    width: 2.28rem;
    height: 2.28rem;
    border: 1px solid #b7ad99;
    border-radius: 0.48rem;
    background: #e8e1d2;
  }

  html[data-novel-reader-theme="dark"] .bfang-boot-skeleton__novel-controls .bfang-boot-skeleton__block {
    border-color: #474747;
    background: #242424;
  }

  .bfang-boot-skeleton__novel-copy {
    display: grid;
    gap: 0.85rem;
  }

  .bfang-boot-skeleton__novel-copy .bfang-boot-skeleton__block {
    width: 100%;
    height: 14px;
  }

  .bfang-boot-skeleton__novel-copy .bfang-boot-skeleton__block:nth-child(3n + 2) {
    width: 94%;
  }

  .bfang-boot-skeleton__novel-copy .bfang-boot-skeleton__block:nth-child(4n) {
    width: 86%;
  }

  .bfang-boot-skeleton__novel-copy .bfang-boot-skeleton__block:last-child {
    width: 62%;
  }

  .bfang-boot-skeleton__published-list {
    overflow: hidden;
    border: 1px solid #292929;
    border-radius: 0.85rem;
    background: #111111;
  }

  .bfang-boot-skeleton__published-row {
    display: grid;
    grid-template-columns: minmax(180px, 260px) minmax(0, 1fr);
    gap: 1.6rem;
    padding: 0.9rem;
  }

  .bfang-boot-skeleton__published-row + .bfang-boot-skeleton__published-row {
    border-top: 1px solid #292929;
  }

  .bfang-boot-skeleton__published-cover {
    width: 100%;
    aspect-ratio: 3 / 4;
    border: 1px solid #303030;
    border-radius: 0.7rem;
    background: #202020;
  }

  .bfang-boot-skeleton__published-body {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 0.1rem;
  }

  .bfang-boot-skeleton__published-title {
    width: min(470px, 78%);
    height: 26px;
  }

  .bfang-boot-skeleton__published-meta,
  .bfang-boot-skeleton__published-copy {
    display: grid;
    gap: 0.55rem;
  }

  .bfang-boot-skeleton__published-meta .bfang-boot-skeleton__block {
    width: 72%;
    height: 14px;
  }

  .bfang-boot-skeleton__published-copy .bfang-boot-skeleton__block {
    width: 100%;
    height: 13px;
  }

  .bfang-boot-skeleton__published-copy .bfang-boot-skeleton__block:last-child {
    width: 64%;
  }

  .bfang-boot-skeleton__account-panel {
    display: grid;
    gap: 1.2rem;
    min-height: 380px;
    padding: 1.25rem;
  }

  .bfang-boot-skeleton__account-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .bfang-boot-skeleton__account-title {
    display: grid;
    gap: 0.55rem;
    width: min(620px, 72%);
  }

  .bfang-boot-skeleton__account-title .bfang-boot-skeleton__block:first-child {
    width: 210px;
    height: 30px;
  }

  .bfang-boot-skeleton__account-title .bfang-boot-skeleton__block:last-child {
    width: 100%;
    height: 12px;
  }

  .bfang-boot-skeleton__account-action {
    width: 112px;
    height: 38px;
    border-radius: 0.7rem;
  }

  .bfang-boot-skeleton__account-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 1rem;
  }

  .bfang-boot-skeleton__account-side,
  .bfang-boot-skeleton__account-content {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    min-height: 220px;
    padding: 0.85rem;
    border: 1px solid #292929;
    background: #151515;
  }

  .bfang-boot-skeleton__account-side .bfang-boot-skeleton__block {
    width: 100%;
    height: 38px;
  }

  .bfang-boot-skeleton__account-side .bfang-boot-skeleton__block:first-child {
    width: 58%;
    height: 15px;
  }

  .bfang-boot-skeleton__account-content .bfang-boot-skeleton__block:first-child {
    width: 180px;
    height: 22px;
  }

  .bfang-boot-skeleton__account-content .bfang-boot-skeleton__block:not(:first-child) {
    width: 100%;
    height: 44px;
  }

  .bfang-boot-skeleton--chat .bfang-boot-skeleton__main {
    width: 100%;
    height: 100%;
    padding: 0;
  }

  .bfang-boot-skeleton__chat {
    display: grid;
    grid-template-columns: minmax(296px, 348px) minmax(0, 1fr);
    height: 100%;
  }

  .bfang-boot-skeleton__chat-side {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 0.9rem;
    border-right: 1px solid #292929;
    background: #141414;
  }

  .bfang-boot-skeleton__chat-side > .bfang-boot-skeleton__block:first-child {
    width: 132px;
    height: 24px;
  }

  .bfang-boot-skeleton__chat-search {
    width: 100%;
    height: 38px;
    border: 1px solid #303030;
    background: #191919;
  }

  .bfang-boot-skeleton__chat-thread {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 0.65rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid #292929;
  }

  .bfang-boot-skeleton__chat-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #202020;
  }

  .bfang-boot-skeleton__chat-thread-copy,
